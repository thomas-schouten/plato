# VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
# Local History for Visual Studio Code
.history/

# Common credential files
**/credentials.json
**/client_secrets.json
**/client_secret.json

# Ignore any file starting with "_defence" in the notebooks folder
notebooks/_defence*

# macOS
.DS_Store

# Python
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# Office lock files (created while a file is open in Excel/Word)
~$*

# Sphinx build output (the docs workflow builds these itself)
docs/build/
doctrees/